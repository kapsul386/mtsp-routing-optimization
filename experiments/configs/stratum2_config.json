{
  "instance_dir": "data/mtsp/generated_multifamily",
  "instance_glob": "*.txt",
  "allowed_node_counts": [5000, 10000],
  "allowed_salesman_counts": [3, 5, 7],
  "instance_families": ["uniform", "clustered-center", "clustered-offset-depot"],
  "results_csv": "data/results/stratum2_results.csv",
  "summary_csv": "data/results/stratum2_summary.csv",
  "report_md": "data/results/stratum2_report.md",
  "solvers": [
    {
      "name": "2opt+greed",
      "args": ["--step", "2opt+greed"]
    },
    {
      "name": "lkh3-baseline",
      "args": [
        "--step", "lkh3-baseline",
        "--objective", "minsum",
        "--time-budget-ms", "70000"
      ]
    },
    {
      "name": "lkh-wrapper-v21",
      "args": [
        "--step", "lkh-wrapper-v21",
        "--seed", "42",
        "--time-budget-ms", "70000"
      ]
    },
    {
      "name": "lkh_v21_minsum",
      "args": [
        "--step", "lkh_v21_minsum",
        "--time-budget-ms", "70000"
      ]
    },
    {
      "name": "lkh_v21_minsum_cap",
      "args": [
        "--step", "lkh_v21_minsum_cap",
        "--time-budget-ms", "70000"
      ]
    },
    {
      "name": "lkh_v21_minsum_depot2m_plus",
      "args": [
        "--step", "lkh_v21_minsum_depot2m_plus",
        "--time-budget-ms", "70000"
      ]
    },
    {
      "name": "lkh_v21_minmax",
      "args": [
        "--step", "lkh_v21_minmax",
        "--time-budget-ms", "70000"
      ]
    }
  ]
}
