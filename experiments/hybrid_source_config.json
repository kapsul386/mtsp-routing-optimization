{
  "instance_dir": "data/mtsp/generated_multifamily",
  "instance_glob": "*.txt",
  "allowed_node_counts": [20, 50, 100, 200, 500, 1000],
  "results_csv": "data/results/hybrid_source_results.csv",
  "summary_csv": "data/results/hybrid_source_summary.csv",
  "report_md": "data/results/hybrid_source_report.md",
  "solvers": [
    {
      "name": "rand+nn",
      "args": ["--step", "rand+nn", "--seed", "42"]
    },
    {
      "name": "2opt+greed",
      "args": ["--step", "2opt+greed"]
    },
    {
      "name": "lkh-wrapper-v2",
      "args": [
        "--step", "lkh-wrapper-v2",
        "--rounds", "24",
        "--seed", "42",
        "--candidate-count", "12",
        "--lookahead-weight", "0.35",
        "--depot-weight", "0.12"
      ]
    },
    {
      "name": "lkh-wrapper-v3",
      "args": [
        "--step", "lkh-wrapper-v3",
        "--rounds", "24",
        "--seed", "42",
        "--candidate-count", "12",
        "--lookahead-weight", "0.35",
        "--depot-weight", "0.12"
      ]
    }
  ]
}
